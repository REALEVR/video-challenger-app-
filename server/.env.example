# Copy to .env and adjust as needed.

# "production" turns on secure (HTTPS-only) cookies and a couple of other
# hardening switches — leave unset/"development" for local work over HTTP.
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: any Postgres will do, including a throwaway Docker one.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/video_challenger"
#
# Hosted trial: Neon free tier (https://neon.tech). Use the POOLED connection
# string — the host contains "-pooler". A serverless or multi-instance API
# opens more connections than a free Neon project allows direct.
#   DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
#
# `prisma migrate` needs a session-mode connection, so run migrations against
# the DIRECT (non-pooled) URL instead. See docs/DEPLOYMENT.md.

# Long, random string in production. Used to sign auth JWTs.
# Generate one: openssl rand -base64 32
JWT_SECRET="dev-only-change-me"

PORT=4000

# Origin allowed by CORS. Set to your deployed client URL in production,
# e.g. https://your-app.vercel.app — otherwise the browser blocks every call.
CLIENT_ORIGIN="http://localhost:5173"

# Where uploaded submission videos are written and served from.
# NOTE: this needs a host with a persistent writable disk. It does not work on
# Vercel serverless — see docs/DEPLOYMENT.md for why and what to do instead.
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=200

# Optional: Stripe Connect for real payouts. Leave unset to run payouts in
# SIMULATED mode (amounts are computed and recorded, but no money moves —
# safe for demos and for developing the flow without a Stripe account).
STRIPE_SECRET_KEY=
STRIPE_CONNECT_RETURN_URL="http://localhost:5173/profile"
STRIPE_CONNECT_REFRESH_URL="http://localhost:5173/profile"
