# Vite reads this at build time. Point at the server's public URL in production.
#
# Local dev can also leave this empty — vite.config.ts proxies /api and
# /uploads to the server, so a relative base URL works too.
#
# On Vercel, set this to your deployed API's URL with no trailing slash. Vite
# inlines VITE_* at BUILD time, so changing it requires a redeploy.
VITE_API_BASE_URL=http://localhost:4000
